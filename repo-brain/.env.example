# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=repo_brain

# Crew LLM: Gemini free tier (aistudio.google.com)
# NOTE: gemini-2.5-flash is retired for new keys — use the 3.x line
# GEMINI_API_KEY is accepted as an alias if that's what your key came as.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Embeddings: Voyage AI (MongoDB-owned), voyage-3.5-lite = 1024 dims.
# NOTE: dims are baked into the Atlas vector index — change EMBEDDING_MODEL only
# BEFORE running scripts/setup_indexes.py (and update EMBEDDING_DIMS in config.py).
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3.5-lite

# Optional: LangSmith tracing for debugging the crew
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=repo-brain
