# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=repo_brain

# Atlas Administration API (optional; URI is enough for the driver)
MONGODB_API=

# LLM — Gemini. GOOGLE_API_KEY is what LangChain / google-genai read.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=repobrain

# Embeddings: openai text-embedding-3-small (1536 dims) is the default
EMBEDDING_MODEL=text-embedding-3-small
