# Copy to .env and fill in. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=repo_brain

# LLM for the crew (pick one, or use OpenRouter credits)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Embeddings: openai text-embedding-3-small (1536 dims) is the default
EMBEDDING_MODEL=text-embedding-3-small
